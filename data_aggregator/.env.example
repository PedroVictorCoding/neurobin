# Environment variables for ChemBio Importer

# Database configuration
DATABASE_URL=sqlite:///chem_react.db
DATABASE_ECHO=false

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=chembio_importer.log

# API rate limiting
SLOW_MODE=true
SLEEP_INTERVAL=2
MAX_RETRIES=3

# Optional: PostgreSQL database (uncomment and configure if preferred)
# DATABASE_URL=postgresql://username:password@localhost:5432/chembio_db

# Optional: Custom ChEMBL settings
# CHEMBL_BATCH_SIZE=100
# CHEMBL_TIMEOUT=60

# Optional: Custom Reactome settings  
# REACTOME_SPECIES=Homo sapiens,Mus musculus
