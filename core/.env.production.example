# Django
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=neurob.in,www.neurob.in
CSRF_TRUSTED_ORIGINS=https://neurob.in,https://www.neurob.in

# Database (recommended for production)
DATABASE_URL=postgresql://neurobin_user:replace_password@127.0.0.1:5432/neurobin_db
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# HTTPS / reverse proxy
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Cache and Celery
CACHE_BACKEND=redis
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Logging
REQUEST_LOG_DIR=/var/log/neurobin/request_logs
REQUEST_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARNING
DJANGO_LOG_LEVEL=INFO

# Optional integrations
GEMINI_API_KEY=
ABUSEIPDB_API_KEY=
ABUSEIPDB_DOMAIN_VERIFICATION_TOKEN=
GEMINI_MODEL=gemini-2-flash
GEMINI_MODEL_PRIORITY=
GEMINI_GRAPH_MAX_RETRIES=2
# Staff-only metabolic assessment hardening
METABOLIC_ASSESSMENT_ENABLED=False
METABOLIC_ASSESSMENT_STAFF_ALLOWLIST=
CLINICAL_DOCUMENT_ROOT=/var/lib/neurobin/private-clinical
# Comma-separated version:urlsafe-base64-32-byte-key entries; retain previous keys during rotation.
CLINICAL_DOCUMENT_KEYS=
CLINICAL_DOCUMENT_ACTIVE_KEY=
CLINICAL_DOCUMENT_RETENTION_DAYS=30
CLAMAV_UNIX_SOCKET=/run/clamav/clamd.ctl
OPENFDA_API_KEY=
